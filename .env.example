# Anthropic API key, used by /api/chat and the blog auto-generation pipeline
ANTHROPIC_API_KEY=

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Blob store token, used to store generated blog posts
# Create via Vercel dashboard: Storage -> Create Database -> Blob (access: public)
BLOB_READ_WRITE_TOKEN=

# Pexels API key, used to pick the blog post cover image
# Get one free at https://www.pexels.com/api/new/
PEXELS_API_KEY=

# Random secret (16+ chars) that authorizes the daily cron job
# Must match the CRON_SECRET set in Vercel project env vars
CRON_SECRET=
